# Spandan backend environment — template.
#
# Copy to backend/.env (local dev) or backend/.env.test (unit tests) and fill
# in real values there. Never commit a filled-in copy: every backend/.env.*
# file except this one is git-ignored.
#
# Source of truth: src/config/env.js (zod schema). The app exits on boot when a
# required variable is missing or invalid. Placeholders below are NOT valid
# credentials. CHANGE_ME values deliberately fail validation, so the server will
# not start until they are replaced with real secrets.
#
# Required = must be set. "prod" = required when NODE_ENV=production.

# --- Runtime ---------------------------------------------------------------
# Required for the server: src/server.js refuses to start with NODE_ENV unset.
NODE_ENV=development
PORT=4000
# prod: frontend origin (CORS allow-list, OAuth and e-mail links).
CLIENT_URL=http://localhost:5173
# Comma-separated extra CORS origins, e.g. a preview deployment.
# CORS_EXTRA_ORIGINS=
JSON_BODY_LIMIT=2mb
# prod: public URL of this backend (OAuth callbacks, Twilio signatures, widget snippet).
APP_URL=http://localhost:4000
# Public origin that serves /api/v1 when it differs from APP_URL. Defaults to APP_URL.
# API_PUBLIC_URL=
# Reverse-proxy hops in front of the app whose X-Forwarded-For is trusted.
# 0 locally; 1 on Render and on the VPS (nginx). Rate limits key on req.ip.
TRUST_PROXY_HOPS=0
# Adds raw 5xx error messages to API responses. Only honoured with
# NODE_ENV=development. Never enable on a server.
EXPOSE_ERROR_DETAIL=false

# --- Database / Redis -----------------------------------------------------
# Required. Use a LOCAL database for development and tests: test and check
# scripts refuse to run against anything else (scripts/require-local-db.js).
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/spandan_dev
# Non-pooled connection for migrations. Defaults to DATABASE_URL.
# DIRECT_URL=
# Prisma connections per process (default 5). Ignored when DATABASE_URL sets connection_limit.
DATABASE_POOL_SIZE=5
# 1 = use the pg driver adapter instead of Prisma's native engine (sandboxed CI only).
# PRISMA_PG_ADAPTER=
# prod. Every deployment that shares a database must share this Redis too.
REDIS_URL=redis://localhost:6379

# --- Background work ------------------------------------------------------
# Whether this process runs the BullMQ workers, repeatable schedules, boot
# recovery and the billing sweep. Exactly ONE process per database may be true
# (DEPLOY.md, "One worker owner per database").
RUN_WORKERS=true
# (SERVE_HTTP is set to false internally by `npm run start:worker`; do not set it here.)
WORKER_DRAIN_DELAY_SEC=60
WORKER_STALLED_INTERVAL_MS=300000
CAMPAIGN_BATCH_SIZE=50
CAMPAIGN_WORKER_CONCURRENCY=2
CAMPAIGN_RATE_DELAY_MS=250

# --- Auth -----------------------------------------------------------------
# Required, at least 32 characters each. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=CHANGE_ME
JWT_REFRESH_SECRET=CHANGE_ME
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
# Required. The single platform super-admin login (unlocks /admin/platform/*).
ADMIN_EMAIL=admin@example.com
BCRYPT_SALT_ROUNDS=12
# Required. Google OAuth ("Sign in with Google").
GOOGLE_CLIENT_ID=replace-me.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=replace-me
# Defaults to {API_PUBLIC_URL}/api/v1/auth/google/callback.
# GOOGLE_CALLBACK_URL=

# --- Encryption at rest -----------------------------------------------------
# Required: exactly 32 ASCII characters or 64 hex characters. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=CHANGE_ME
# Comma-separated old keys still accepted for decryption during a rotation.
# After rotating, run `node scripts/reencrypt-secrets.js --apply`, then clear this.
# ENCRYPTION_KEYS_PREVIOUS=

# --- Meta / WhatsApp Cloud API -------------------------------------------------
# Required (the server boots with placeholders, but nothing reaches Meta).
META_APP_ID=replace-me
META_APP_SECRET=replace-me
META_BUSINESS_ID=replace-me
META_WABA_ID=replace-me
META_SYSTEM_USER_TOKEN=replace-me
META_WEBHOOK_VERIFY_TOKEN=replace-with-a-random-string
# Optional, not read by the app.
# META_SYSTEM_USER_ID=
# META_DISPLAY_NAME=
# 6-digit two-step verification PIN, for registering numbers that already have one.
# META_TWO_STEP_PIN=
META_API_VERSION=v21.0
# Defaults to {API_PUBLIC_URL}/api/v1/auth/meta/callback.
# META_REDIRECT_URI=
# Embedded Signup configuration ID (App Dashboard > WhatsApp > Embedded Signup).
# META_ES_CONFIG_ID=

# --- Instagram / Twilio (optional) -------------------------------------------
# INSTAGRAM_APP_ID=
# INSTAGRAM_APP_SECRET=
# INSTAGRAM_REDIRECT_URI=
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=

# --- Billing (Razorpay) ----------------------------------------------------------
# RAZORPAY_KEY_ID=
# RAZORPAY_KEY_SECRET=
# Secret of the dashboard webhook at POST /api/v1/webhook/razorpay
# (events payment.captured, order.paid). The route answers 503 without it.
# RAZORPAY_WEBHOOK_SECRET=
# Demo wallet top-up without payment. Only works outside production AND when "true".
ALLOW_DEMO_RECHARGE=false

# --- E-mail (optional; sending is skipped when SMTP_HOST is empty) ------------
# SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASSWORD=
# 4 = force IPv4 (default), 6 = IPv6, 0 = let Node choose.
SMTP_IP_FAMILY=4
EMAIL_FROM_NAME=Spandan
# EMAIL_FROM=

# --- AI (all optional; features degrade without them) --------------------------
# GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest
GEMINI_FALLBACK_MODEL=gemini-flash-lite-latest
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
GEMINI_EMBEDDING_DIM=768
GEMINI_IMAGE_MODEL=gemini-2.5-flash-image
# OPENAI_API_KEY=
OPENAI_IMAGE_MODEL=gpt-image-1
OPENAI_IMAGE_QUALITY=medium
# CLOUDFLARE_ACCOUNT_ID=
# CLOUDFLARE_API_TOKEN=
CLOUDFLARE_IMAGE_MODEL=@cf/black-forest-labs/flux-1-schnell
# auto | openai | cloudflare | gemini
IMAGE_PROVIDER=auto
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=phi3
# Voice notes (WhatsApp and Instagram) are transcribed with GEMINI_API_KEY so
# they reach keyword triggers, workflows and the AI agent. "false" turns it off;
# without a key they are routed as audio messages (workflow "Media Received").
VOICE_TRANSCRIPTION=true

# --- File storage (lib/storage) -------------------------------------------------
# Inbound/outbound WhatsApp and Instagram media, and template header images.
# Unset, files go to local disk (STORAGE_DISK_ROOT, default backend/uploads),
# which is fine on the VPS and LOST ON EVERY RENDER DEPLOY. Setting S3_BUCKET
# selects any S3-compatible bucket:
#   AWS S3            S3_REGION=ap-south-1                     (no endpoint)
#   Cloudflare R2     S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com  S3_REGION=auto
#   Supabase Storage  S3_ENDPOINT=https://<project-ref>.supabase.co/storage/v1/s3  S3_REGION=<project region>
#   MinIO             S3_ENDPOINT=http://127.0.0.1:9000  S3_REGION=us-east-1
# Keep the bucket private: the app streams files to signed-in users itself.
# Move existing files with scripts/migrate-uploads-to-object-storage.js (DEPLOY.md §4).
# STORAGE_DRIVER=        # disk | s3 — pins one; default s3 when S3_BUCKET is set
# STORAGE_DISK_ROOT=
# S3_BUCKET=
# S3_REGION=
# S3_ENDPOINT=
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_SESSION_TOKEN=      # only for temporary AWS credentials
# S3_FORCE_PATH_STYLE=   # true for path-style addressing on AWS; custom endpoints always use it
# S3_PREFIX=             # e.g. prod — prepended to every key, to share a bucket
# Inbound media larger than this is not archived (still re-fetchable from Meta ~30 days).
MEDIA_ARCHIVE_MAX_BYTES=26214400
