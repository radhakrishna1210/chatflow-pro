generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id               String            @id @default(cuid())
  name             String
  email            String            @unique
  passwordHash     String?
  googleId         String?           @unique
  phone            String?
  jobTitle         String?
  company          String?
  timezone         String?
  language         String?
  lastLoginAt      DateTime?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @default(now()) @updatedAt
  messages         Message[]
  refreshTokens    RefreshToken[]
  workspaceMembers WorkspaceMember[]
  sentInvitations  Invitation[]
  assignedConversations Conversation[] @relation("ConversationAssignee")
  notifications    Notification[]
}

model Workspace {
  id                           String                 @id @default(cuid())
  name                         String
  plan                         String                 @default("FREE")
  webhookUrl                   String?
  webhookVerifyToken           String                 @default("")
  webhookEvents                Json?
  notifyNewConversation        Boolean                @default(true)
  notifyTemplateApproved       Boolean                @default(true)
  notifyTemplateRejected       Boolean                @default(true)
  notifyCampaignCompleted      Boolean                @default(true)
  notifyHighOptout             Boolean                @default(true)
  notifyRateLimit              Boolean                @default(true)
  emailNotifyCampaignCompleted Boolean                @default(true)
  emailNotifyMemberInvite      Boolean                @default(true)
  emailNotifyTemplateApproved  Boolean                @default(true)
  emailNotifyTemplateRejected  Boolean                @default(true)
  autoOooEnabled               Boolean                @default(true)
  autoWelcomeEnabled           Boolean                @default(true)
  autoDelayedEnabled           Boolean                @default(false)
  // The three basic auto-replies used to be hardcoded constants in
  // webhook.service.js while the UI claimed they were configurable. They are
  // real editable fields now.
  welcomeMessage               String                 @default("Thanks for reaching out! We've received your message and will get back to you shortly.")
  oooMessage                   String                 @default("We're currently unavailable. We'll respond to your message as soon as possible.")
  delayedMessage               String                 @default("Sorry for the wait — we're still looking into this and will reply as soon as we can.")
  // How long an inbound message may sit without a human reply before the
  // delayed-response auto-reply fires.
  delayedAfterMinutes          Int                    @default(15)
  // { tz: "Asia/Kolkata", days: [{ day: 0-6, enabled: bool, start: "09:00", end: "18:00" }] }
  // Null means "always open" — OOO then only fires on reopened conversations.
  businessHours                Json?
  voiceAiEnabled               Boolean                @default(false)
  voiceAiName                  String                 @default("MyCallGenie")
  voiceAiPrompt                String                 @default("Greet the caller and ask for their details.")
  voiceAiPhone                 String                 @default("")
  // Voice AI answers on this inbound number (provisioned with the telephony
  // provider); voiceAiPhone is where calls are forwarded on handoff.
  voiceAiInboundPhone          String                 @default("")
  voiceAiGreeting              String                 @default("Hi! Thanks for calling. How can I help you today?")
  instagramUserId              String?
  instagramUsername            String?
  // Encrypted at rest via lib/encryption.js, same as WaNumber access tokens.
  instagramAccessToken         String?
  instagramConnectedAt         DateTime?
  aiAgentEnabled               Boolean                @default(false)
  aiAgentName                  String                 @default("Assistant")
  aiAgentPrompt                String                 @default("You are a helpful customer support agent. Answer briefly and politely.")
  aiAgentKnowledge             String                 @default("")
  aiAgentModel                 String                 @default("gemini-1.5-flash")
  aiAgentDeployedAt            DateTime?
  intentMatchingEnabled        Boolean                @default(false)
  intentMatchThreshold         Float                  @default(0.6)
  suspended                    Boolean                @default(false)
  suspendedReason              String?
  walletBalance                Decimal                @default(0) @db.Decimal(12, 2)
  // What one campaign message costs this workspace, in the wallet's currency
  // (INR). Campaign cost = valid recipients × this, charged once at launch.
  // Workspace-level so a reseller can price per account without a plan change.
  costPerMessage               Decimal                @default(0.92) @db.Decimal(10, 4)
  createdAt                    DateTime               @default(now())
  apiKeys                      ApiKey[]
  triggers                     AutomationTrigger[]
  campaigns                    Campaign[]
  contacts                     Contact[]
  conversations                Conversation[]
  invoices                     Invoice[]
  templates                    Template[]
  waNumbers                    WaNumber[]
  members                      WorkspaceMember[]
  workflows                    Workflow[]
  segments                     Segment[]
  whatsappForms                WhatsappForm[]
  walletTransactions           WalletTransaction[]
  integrations                 WorkspaceIntegration[]
  supportTickets               SupportTicket[]
  subscription                 Subscription?
  usageCounters                UsageCounter[]
  invitations                  Invitation[]
  clusters                     Cluster[]
  workflowRuns                 WorkflowRun[]
  formSubmissions              WhatsappFormSubmission[]
  instagramFlows               InstagramFlow[]
  voiceCalls                   VoiceCall[]
  optOuts                      OptOut[]
  notifications                Notification[]
}

model WorkspaceMember {
  userId      String
  workspaceId String
  role        Role      @default(CLIENT)
  joinedAt    DateTime  @default(now())
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@id([userId, workspaceId])
}

model Invitation {
  id              String           @id @default(cuid())
  workspaceId     String
  email           String
  role            Role             @default(CLIENT)
  tokenHash       String           @unique
  status          InvitationStatus @default(PENDING)
  invitedByUserId String
  expiresAt       DateTime
  acceptedAt      DateTime?
  revokedAt       DateTime?
  createdAt       DateTime         @default(now())
  workspace       Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  invitedBy       User             @relation(fields: [invitedByUserId], references: [id])

  @@index([workspaceId, email])
  @@index([workspaceId, status])
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  REVOKED
  EXPIRED
}

model WaNumber {
  id                   String         @id @default(cuid())
  workspaceId          String
  phoneNumber          String
  metaPhoneNumberId    String
  wabaId               String
  encryptedAccessToken String
  displayName          String?
  quality              String?
  status               String         @default("ACTIVE")
  messagingLimit       String?
  appSubscribed        Boolean        @default(false)
  createdAt            DateTime       @default(now())
  campaigns            Campaign[]
  conversations        Conversation[]
  templates            Template[]
  workspace            Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
}

model NumberPool {
  id                   String           @id @default(cuid())
  phoneNumber          String           @unique
  phoneNumberId        String?
  wabaId               String?
  encryptedAccessToken String?
  displayName          String?
  status               NumberPoolStatus @default(AVAILABLE)
  assignedTo           String?
  registeredAt         DateTime?
  createdAt            DateTime         @default(now())
  provider             String           @default("META")
  twilioSid            String?
}

model Template {
  id             String         @id @default(cuid())
  workspaceId    String
  waNumberId     String?
  metaTemplateId String?
  name           String
  category       String
  language       String
  components     Json
  status         TemplateStatus @default(PENDING)
  aiGenerated    Boolean        @default(false)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @default(now()) @updatedAt
  campaigns      Campaign[]
  workspace      Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  waNumber       WaNumber?      @relation(fields: [waNumberId], references: [id], onDelete: Cascade)
}

model Contact {
  id                 String              @id @default(cuid())
  workspaceId        String
  name               String
  phoneNumber        String
  email              String?
  tags               String[]
  optedOut           Boolean             @default(false)
  optedOutAt         DateTime?
  createdAt          DateTime            @default(now())
  campaignRecipients CampaignRecipient[]
  workspace          Workspace           @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  conversations      Conversation[]
  segments           Segment[]           @relation("ContactSegments")
  clusterContacts    ClusterContact[]

  @@unique([workspaceId, phoneNumber])
}

model Campaign {
  id             String              @id @default(cuid())
  workspaceId    String
  name           String
  templateId     String
  waNumberId     String?
  status         CampaignStatus      @default(DRAFT)
  totalContacts  Int                 @default(0)
  sent           Int                 @default(0)
  delivered      Int                 @default(0)
  read           Int                 @default(0)
  failed         Int                 @default(0)
  // Recipients never sent to because the number opted out. Counted separately
  // from `failed` — a blocked number is a skip, not a delivery error, and it
  // must never stop the rest of the campaign.
  skipped        Int                 @default(0)
  // Wallet accounting, written once when the launch charge succeeds.
  // `chargedAt` is the idempotency guard: a campaign with it set is already
  // paid for and can never be charged again (retry, resume, worker restart).
  costPerMessage Decimal?            @db.Decimal(10, 4)
  totalCost      Decimal?            @db.Decimal(12, 2)
  walletBefore   Decimal?            @db.Decimal(12, 2)
  walletAfter    Decimal?            @db.Decimal(12, 2)
  chargedAt      DateTime?
  refundAmount   Decimal?            @db.Decimal(12, 2)
  refundedAt     DateTime?
  createdByUserId String?
  scheduledAt    DateTime?
  launchedAt     DateTime?
  completedAt    DateTime?
  aiGenerated    Boolean             @default(false)
  queueJobId     String?
  replyRules     Json?
  retryConfig    Json?
  trackingConfig Json?
  fallbackConfig Json?
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @default(now()) @updatedAt
  template       Template            @relation(fields: [templateId], references: [id])
  waNumber       WaNumber?           @relation(fields: [waNumberId], references: [id], onDelete: SetNull)
  workspace      Workspace           @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  recipients     CampaignRecipient[]
}

model CampaignRecipient {
  id          String                  @id @default(cuid())
  campaignId  String
  contactId   String
  status      CampaignRecipientStatus @default(PENDING)
  sentAt      DateTime?
  deliveredAt DateTime?
  readAt            DateTime?
  failedAt          DateTime?
  failReason        String?
  retryCount        Int                     @default(0)
  lastRetryAt       DateTime?
  nextRetryAt       DateTime?
  lastFailureReason String?
  retryStatus       String?
  campaign          Campaign                @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  contact     Contact                 @relation(fields: [contactId], references: [id], onDelete: Cascade)
  messages    Message[]

  @@unique([campaignId, contactId])
}

model Conversation {
  id            String             @id @default(cuid())
  workspaceId   String
  contactId     String
  waNumberId    String?
  status        ConversationStatus @default(OPEN)
  unreadCount   Int                @default(0)
  label         String?
  // Set by a workflow's "assign to agent" action, or manually from the inbox.
  // SetNull so removing a member detaches their threads instead of blocking.
  assignedToUserId String?
  lastMessageAt DateTime           @default(now())
  createdAt     DateTime           @default(now())
  contact       Contact            @relation(fields: [contactId], references: [id], onDelete: Cascade)
  waNumber      WaNumber?          @relation(fields: [waNumberId], references: [id], onDelete: SetNull)
  workspace     Workspace          @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  assignedTo    User?              @relation("ConversationAssignee", fields: [assignedToUserId], references: [id], onDelete: SetNull)
  messages      Message[]
  workflowRuns  WorkflowRun[]
}

model Message {
  id                  String             @id @default(cuid())
  conversationId      String
  body                String
  direction           MessageDirection
  metaMessageId       String?
  senderUserId        String?
  campaignRecipientId String?
  sentAt              DateTime           @default(now())
  createdAt           DateTime           @default(now())
  conversation        Conversation       @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  senderUser          User?              @relation(fields: [senderUserId], references: [id])
  campaignRecipient   CampaignRecipient? @relation(fields: [campaignRecipientId], references: [id], onDelete: SetNull)

  @@index([metaMessageId])
}

model AutomationTrigger {
  id               String    @id @default(cuid())
  workspaceId      String
  keyword          String
  responseTemplate String
  isActive         Boolean   @default(true)
  createdAt        DateTime  @default(now())
  workspace        Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, keyword])
}

model Workflow {
  id          String    @id @default(cuid())
  workspaceId String
  name        String
  isActive    Boolean   @default(true)
  nodes       Json
  edges       Json
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  runs        WorkflowRun[]
}

// One execution of a workflow against one conversation. Persisted (rather than
// held in the queue job) because a "delay" step can park a run for a day, and
// the Workflows tab shows the run history so "did it fire?" is answerable
// without reading logs.
model WorkflowRun {
  id             String            @id @default(cuid())
  workspaceId    String
  workflowId     String
  conversationId String?
  contactId      String?
  status         WorkflowRunStatus @default(RUNNING)
  // Index into the workflow's action nodes — where to resume after a delay.
  cursor         Int               @default(0)
  // Snapshot of the nodes at trigger time, so editing a workflow mid-run
  // doesn't make an in-flight run jump to a different set of steps.
  nodes          Json
  trace          Json?
  triggerMessage String?
  error          String?
  startedAt      DateTime          @default(now())
  finishedAt     DateTime?
  workflow       Workflow          @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  workspace      Workspace         @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  conversation   Conversation?     @relation(fields: [conversationId], references: [id], onDelete: SetNull)

  @@index([workspaceId, startedAt])
  @@index([workflowId, startedAt])
}

enum WorkflowRunStatus {
  RUNNING
  WAITING
  COMPLETED
  FAILED
}

model ApiKey {
  id          String    @id @default(cuid())
  workspaceId String
  name        String
  keyHash     String
  keyPrefix   String
  environment String    @default("production")
  lastUsedAt  DateTime?
  createdAt   DateTime  @default(now())
  revokedAt   DateTime?
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
}

model Invoice {
  id          String    @id @default(cuid())
  workspaceId String
  invoiceDate DateTime
  description String?
  amount      Float
  currency    String    @default("USD")
  status      String    @default("PAID")
  reference   String? // gateway payment id, for reconciliation
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
}

model RefreshToken {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

enum Role {
  ADMIN
  CLIENT
}

enum NumberPoolStatus {
  AVAILABLE
  ASSIGNED
  BANNED
  PROVISIONING
}

enum TemplateStatus {
  PENDING
  APPROVED
  REJECTED
  DELETED
}

enum CampaignStatus {
  DRAFT
  SCHEDULED
  RUNNING
  COMPLETED
  FAILED
  CANCELLED
}

enum CampaignRecipientStatus {
  PENDING
  RETRYING
  SENT
  DELIVERED
  READ
  FAILED
  SKIPPED
}

enum ConversationStatus {
  OPEN
  RESOLVED
  PENDING
}

enum MessageDirection {
  INBOUND
  OUTBOUND
}

model AiSession {
  id          String   @id @default(cuid())
  userId      String?
  workspaceId String?
  state       Json     @default("{}")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Segment {
  id          String    @id @default(cuid())
  workspaceId String
  name        String
  desc        String?
  color       String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  contacts    Contact[] @relation("ContactSegments")
}

model WhatsappForm {
  id          String    @id @default(cuid())
  workspaceId String
  name        String
  // Denormalised counters kept for the existing list UI. `fields` is derived
  // from `schema` on every write so the two can't drift.
  submissions Int       @default(0)
  fields      Int       @default(1)
  status      String    @default("Draft")
  // The actual field definitions the form collects:
  // [{ key, label, type: text|email|phone|number|choice, required, options[] }]
  schema      Json?
  // Free-form organisational tags, e.g. ["Feedback","Survey"]. Used to filter
  // the forms list; carries no runtime behaviour.
  categories  Json?
  // Keyword that starts the form over WhatsApp, e.g. "SURVEY".
  keyword     String?
  // Sent once every field has been answered.
  completionMessage String  @default("Thanks! We've recorded your response.")
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  formSubmissions WhatsappFormSubmission[]

  @@unique([workspaceId, keyword])
}

// A contact's run through a form. Rows start PARTIAL and are filled in one
// answer per inbound message until every field is collected.
model WhatsappFormSubmission {
  id             String    @id @default(cuid())
  workspaceId    String
  formId         String
  contactId      String?
  conversationId String?
  // { fieldKey: answer }
  answers        Json      @default("{}")
  // Index of the field currently being asked.
  cursor         Int       @default(0)
  completed      Boolean   @default(false)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  completedAt    DateTime?
  form           WhatsappForm @relation(fields: [formId], references: [id], onDelete: Cascade)
  workspace      Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, formId])
  @@index([conversationId, completed])
}

// Instagram DM / comment / story-reply automation. Mirrors AutomationTrigger
// but for the IG surface, which has its own webhook and send API.
model InstagramFlow {
  id          String    @id @default(cuid())
  workspaceId String
  name        String
  // dm | comment | story_reply
  source      String    @default("dm")
  // Empty keyword means "match every message on this source".
  keyword     String    @default("")
  responseTemplate String
  // For comment flows: also DM the commenter, not just reply publicly.
  alsoSendDm  Boolean   @default(false)
  isActive    Boolean   @default(true)
  triggeredCount Int    @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, isActive])
}

// One inbound call handled by the Voice AI receptionist, plus whatever the
// agent managed to capture from the caller.
model VoiceCall {
  id           String    @id @default(cuid())
  workspaceId  String
  providerCallId String?
  fromPhone    String
  toPhone      String
  status       String    @default("IN_PROGRESS")
  // [{ role: 'caller'|'agent', text, at }]
  transcript   Json      @default("[]")
  leadName     String?
  leadEmail    String?
  leadSummary  String?
  contactId    String?
  forwarded    Boolean   @default(false)
  durationSec  Int       @default(0)
  startedAt    DateTime  @default(now())
  endedAt      DateTime?
  workspace    Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, startedAt])
  @@unique([providerCallId])
}

model WalletTransaction {
  id            String    @id @default(cuid())
  workspaceId   String
  amount        Decimal   @db.Decimal(12, 2)
  // CREDIT | DEBIT — the direction. `category` is what it was for:
  // RECHARGE | CAMPAIGN | REFUND | USAGE | ADJUSTMENT.
  type          String
  category      String    @default("USAGE")
  reason        String
  balanceBefore Decimal?  @db.Decimal(12, 2)
  balanceAfter  Decimal   @db.Decimal(12, 2)
  status        String    @default("SUCCESS") // SUCCESS | PENDING | FAILED
  gateway       String? // razorpay | manual | system
  reference     String? // gateway payment id / campaign id
  // Caller-supplied dedupe key. Unique, so a replayed recharge callback or a
  // double-submitted campaign charge collides at the DB level instead of
  // relying on a read-then-write check that two workers can both pass.
  idempotencyKey String?  @unique
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @default(now()) @updatedAt
  workspace     Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, createdAt])
  @@index([workspaceId, category])
}

// A phone number that must never be messaged again from this workspace.
// Written by the webhook when an inbound message matches an opt-out keyword,
// and checked before every outbound send. `phoneNumber` is stored as bare
// digits so "+91 98765 43210", "9198765 43210" and "919876543210" all collide
// on the same row.
model OptOut {
  id           String    @id @default(cuid())
  workspaceId  String
  phoneNumber  String
  // What the customer actually typed, kept for the audit trail.
  rawPhone     String?
  waNumberId   String?
  waPhone      String?
  contactId    String?
  keyword      String?
  reason       String    @default("User Opted Out")
  source       String    @default("Incoming WhatsApp Message")
  // Who blocked it: null for the customer themselves (the normal case), a
  // user id when an admin blocked the number by hand.
  blockedByUserId String?
  blockedByName   String?
  // Soft state so unblocking keeps the history instead of erasing it.
  active       Boolean   @default(true)
  unblockedAt  DateTime?
  unblockedByUserId String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @default(now()) @updatedAt
  workspace    Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, phoneNumber])
  @@index([workspaceId, active, createdAt])
}

// In-app notification. `userId` targets one person (e.g. "you were invited to
// a workspace"); a null userId with a workspaceId is a workspace-wide notice
// every member sees. Read state lives in `readAt` for per-user targets and in
// NotificationRead for workspace-wide ones.
model Notification {
  id          String     @id @default(cuid())
  workspaceId String?
  userId      String?
  type        String
  title       String
  body        String?
  // Dashboard section to open when the notification is clicked, e.g.
  // "campaigns" or "settings".
  link        String?
  meta        Json?
  readAt      DateTime?
  createdAt   DateTime   @default(now())
  workspace   Workspace? @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user        User?      @relation(fields: [userId], references: [id], onDelete: Cascade)
  reads       NotificationRead[]

  @@index([userId, readAt])
  @@index([workspaceId, createdAt])
}

// Per-user read marker for workspace-wide notifications (userId = null on the
// Notification itself), so one member reading a notice doesn't clear it for
// everyone else.
model NotificationRead {
  notificationId String
  userId         String
  readAt         DateTime     @default(now())
  notification   Notification @relation(fields: [notificationId], references: [id], onDelete: Cascade)

  @@id([notificationId, userId])
  @@index([userId])
}

model WorkspaceIntegration {
  id                   String    @id @default(cuid())
  workspaceId          String
  provider             String
  type                 String // apikey | oauth | webhook
  status               String    @default("CONNECTED")
  encryptedCredentials String?
  config               Json?
  connectedAt          DateTime  @default(now())
  updatedAt            DateTime  @default(now()) @updatedAt
  workspace            Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, provider])
}

model EmailOtp {
  id           String   @id @default(cuid())
  email        String
  codeHash     String
  purpose      String   @default("SIGNUP")
  name         String?
  passwordHash String?
  attempts     Int      @default(0)
  consumed     Boolean  @default(false)
  expiresAt    DateTime
  createdAt    DateTime @default(now())

  @@index([email, purpose])
}

model Plan {
  id                String         @id @default(cuid())
  key               String         @unique // "FREE" | "BASIC" | "GROWTH" (legacy: STARTER/PRO/ENTERPRISE)
  name              String
  priceMonthly      Decimal        @db.Decimal(10, 2)
  // Discounted three-month price. Null on plans sold monthly only (and on the
  // free plan); checkout falls back to the monthly cycle when it is absent.
  priceQuarterly    Decimal?       @db.Decimal(10, 2)
  currency          String         @default("INR")
  messageQuota      Int // included messages per billing cycle; 0 = none, -1 = unlimited
  contactLimit      Int? // null = unlimited
  memberLimit       Int?
  campaignLimit     Int?
  apiKeyLimit       Int?
  // Charged per message once messageQuota is exhausted, for a send with no
  // template category (an inbox reply). Category sends use overageRates.
  overageRatePerMsg Decimal        @db.Decimal(10, 4)
  // Optional per-plan override of the per-category message rates, e.g.
  // { "MARKETING": 2.18, "UTILITY": 0.32, "AUTHENTICATION": 0.26 }.
  // Null means "charge cost" — the shared rates in lib/messagePricing.js,
  // which is also what campaign launches are billed at.
  overageRates      Json?
  features          Json           @default("{}")
  isActive          Boolean        @default(true)
  createdAt         DateTime       @default(now())
  subscriptions     Subscription[] @relation("SubscriptionPlan")
  pendingFor        Subscription[] @relation("SubscriptionPendingPlan")
}

model Subscription {
  id                 String    @id @default(cuid())
  workspaceId        String    @unique
  planId             String
  pendingPlanId      String? // scheduled upgrade/downgrade — applied at the next cycle rollover (§12.6/§12.8: no proration)
  status             String    @default("ACTIVE") // ACTIVE | PAST_DUE | CANCELLED | EXPIRED
  currentPeriodStart DateTime  @default(now())
  currentPeriodEnd   DateTime
  cancelAtPeriodEnd  Boolean   @default(false)
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  workspace          Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  plan               Plan      @relation("SubscriptionPlan", fields: [planId], references: [id])
  pendingPlan        Plan?     @relation("SubscriptionPendingPlan", fields: [pendingPlanId], references: [id])
}

model UsageCounter {
  id           String    @id @default(cuid())
  workspaceId  String
  periodStart  DateTime
  periodEnd    DateTime
  messagesUsed Int       @default(0)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  workspace    Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, periodStart])
}

model SupportTicket {
  id          String    @id @default(cuid())
  workspaceId String
  userId      String?
  subject     String
  message     String
  category    String    @default("GENERAL")
  status      String    @default("OPEN")
  adminNote   String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @default(now()) @updatedAt
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([status, createdAt])
}

model Cluster {
  id          String           @id @default(cuid())
  workspaceId String
  name        String
  description String?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @default(now()) @updatedAt
  workspace   Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  contacts    ClusterContact[]

  @@unique([workspaceId, name])
}

model ClusterContact {
  clusterId String
  contactId String
  cluster   Cluster @relation(fields: [clusterId], references: [id], onDelete: Cascade)
  contact   Contact @relation(fields: [contactId], references: [id], onDelete: Cascade)

  @@id([clusterId, contactId])
}
